    struct FMarchingCubeLUT
    {
        int m_TriIndices[15];
        int m_NumTriangles;
    };

    FMarchingCubeLUT DecodeMarchingCubeLUT(int lutIndex)
    {
        FMarchingCubeLUT lut;
        lut.m_NumTriangles = 0;
        
        uint lut0 = kMarchingCubesLUT[lutIndex<<1];
        uint lut1 = kMarchingCubesLUT[(lutIndex<<1) + 1];
        
        uint numVals = (lut1 >> 28) & 0xF;
        uint lut0Ns = min(8,numVals);
        uint lut1Ns = max((int)numVals-8,0);
        for(uint i = 0; i < lut0Ns; ++i)
        {
            lut.m_TriIndices[i] = (lut0 >> (i * 4)) & 0xF;
        }
        for(uint i = 0; i < lut1Ns; ++i)
        {
            lut.m_TriIndices[lut0Ns + i] = (lut1 >> (i * 4)) & 0xF;
        }
        lut.m_NumTriangles = numVals/3;
        return lut;
    }
